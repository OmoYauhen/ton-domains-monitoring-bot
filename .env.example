# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# SQLite connection string (parent dir is created automatically)
DATABASE_URL=sqlite://data/ton.db

# TON API (tonapi.io-compatible). Base URL and optional bearer token.
TONAPI_BASE_URL=https://tonapi.io
# TONAPI_KEY=your-tonapi-token
# Max TON API requests per second (global throttle). Default 1.
TONAPI_RPS=1

# Cron schedules (6-field: sec min hour day-of-month month day-of-week)
# Daily refresh + expiry alerts at 03:00
DAILY_CRON=0 0 3 * * *
# Monthly full summary on the 1st at 09:00
MONTHLY_CRON=0 0 9 1 * *

# Comma-separated days-before-expiry that trigger an alert
ALERT_THRESHOLDS=30,7,1

# Log filter
RUST_LOG=info,sqlx=warn,teloxide=warn
